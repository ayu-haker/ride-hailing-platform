# ============================================================
# RIDE-HAILING PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================

# Node Environment
NODE_ENV=development

# API Gateway
PORT=3000
CORS_ORIGINS=*

# Microservice URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
RIDE_SERVICE_URL=http://ride-service:3003
DRIVER_SERVICE_URL=http://driver-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006
LOCATION_SERVICE_URL=http://location-service:3007
ADMIN_SERVICE_URL=http://admin-service:3008

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=ride_user
DB_PASSWORD=ride_password
DB_DATABASE=ride_hailing
DB_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Firebase Cloud Messaging
FCM_PROJECT_ID=ride-hailing-app
FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----
FCM_CLIENT_EMAIL=firebase-adminsdk@ride-hailing.iam.gserviceaccount.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@ridesharing.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@ridesharing.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# S3 Compatible Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=ride-hailing-uploads

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
