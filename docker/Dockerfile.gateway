FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++

# Build shared library
COPY backend/shared ./shared/
WORKDIR /app/shared
RUN npm install && npx tsc

# Install gateway dependencies (remove @ride/shared first)
WORKDIR /app/service
COPY backend/api-gateway/package.json backend/api-gateway/tsconfig.json backend/api-gateway/tsconfig.build.json ./
RUN sed -i '/@ride\/shared/d' package.json && \
    npm install

# Copy shared library into node_modules preserving dist/ path
RUN mkdir -p node_modules/@ride/shared/dist && \
    cp -r /app/shared/dist/* node_modules/@ride/shared/dist/ && \
    cp /app/shared/package.json node_modules/@ride/shared/package.json

# Copy gateway source and build
COPY backend/api-gateway/ ./
RUN npm run build

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache curl tini

COPY --from=builder /app/service/node_modules ./node_modules
COPY --from=builder /app/service/dist ./dist
COPY --from=builder /app/service/package.json ./

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]

LABEL service="api-gateway" \
      version="1.0.0" \
      description="Ride-hailing API Gateway"
