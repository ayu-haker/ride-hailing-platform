FROM node:20-alpine AS builder

WORKDIR /app

COPY admin-panel/package.json ./
RUN npm install

COPY admin-panel/ ./
RUN npx vite build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
